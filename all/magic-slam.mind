ildren":[]},{"data":{"id":"dfix6cibmvs0","created":1767846199811,"text":"color_transform(图像数据从np->tensor)"},"children":[]}]},{"data":{"id":"dfixs245u9c0","created":1767847901199,"text":"函数"},"children":[{"data":{"id":"dfixs3qo58g0","created":1767847904737,"text":"__len__(self)"},"children":[{"data":{"id":"dfixsa836i80","created":1767847918850,"text":"内部获取dataset帧数，取frame_limit和len(data)的最小值"},"children":[]}]},{"data":{"id":"dfixsv23ozk0","created":1767847964201,"text":"get_point_cloud()"},"children":[{"data":{"id":"dfixt2o76nc0","created":1767847980774,"text":"输入"},"children":[{"data":{"id":"dfixumpvy4w0","created":1767848102776,"text":"frame_id: int"},"children":[]},{"data":{"id":"dfixuox2pww0","created":1767848107565,"text":"pose=None"},"children":[]}]},{"data":{"id":"dfixurfn7a00","created":1767848113041,"text":"输出"},"children":[{"data":{"id":"dfixutbt2c00","created":1767848117162,"text":"point cloud(pcd.points, pcd.colors)"},"children":[{"data":{"id":"dfiycabdgdk0","created":1767849486332,"text":"rgbd2ptcloud(gt_color, gt_depth, self.intrinsics, np.linalg.inv(pose))"},"children":[]}]}]},{"data":{"id":"dfiyahtcipk0","created":1767849345928,"text":"获取点云"},"children":[]}]},{"data":{"id":"dfiy6w1hz9s0","created":1767849063439,"text":"get_render_frame()"},"children":[{"data":{"id":"dfiyaphkxtk0","created":1767849362631,"text":"输入"},"children":[{"data":{"id":"dfiyasn0pe80","created":1767849369490,"text":"frame_id: int"},"children":[]},{"data":{"id":"dfiyavjxyfk0","created":1767849375835,"text":"pose=None"},"children":[]}]},{"data":{"id":"dfiyaxhwgww0","created":1767849380065,"text":"输出"},"children":[{"data":{"id":"dfiyb2ajckw0","created":1767849390503,"text":"包含render信息的字典"},"children":[{"data":{"id":"dfiyb911lpk0","created":1767849405167,"text":"gt_color"},"children":[{"data":{"id":"dfiybg8t0800","created":1767849420874,"text":"self.color_transform(gt_color).cuda()"},"children":[]}]},{"data":{"id":"dfiybapq3u00","created":1767849408836,"text":"gt_depth"},"children":[{"data":{"id":"dfiybkgz49k0","created":1767849430075,"text":"np2torch(gt_depth).cuda()"},"children":[]}]},{"data":{"id":"dfiybcjrlfs0","created":1767849412829,"text":"render_settings"},"children":[{"data":{"id":"dfiybojxpaw0","created":1767849438961,"text":"            \"render_settings\": get_render_settings(self.width, self.height, self.intrinsics, pose)"},"children":[]}]}]}]}]}]},{"data":{"id":"dfjyxpglq1s0","created":1767952724904,"text":"用于记录数据集信息，来自gaussianSLAM,主要信息有：数据集参数、帧id及帧数、相机内参、相机位姿信息及点云"},"children":[]}]},{"data":{"id":"dfivm6c4wyg0","created":1767841797983,"text":"子类Replica(BaseDataset)"},"children":[{"data":{"id":"dfiyd4wsl2w0","created":1767849552931,"text":"结构"},"children":[{"data":{"id":"dfiyd8svsiw0","created":1767849561402,"text":"__init__"},"children":[{"data":{"id":"dfiydanwieo0","created":1767849565454,"text":"继承父类super().__init__(dataset_config)"},"children":[]},{"data":{"id":"dfiydjeb0yg0","created":1767849584465,"text":"实际记录了地址"},"children":[{"data":{"id":"dfiydwjbsa80","created":1767849613067,"text":"        self.color_paths = sorted(list((self.dataset_path / \"results\").glob(\"frame*.jpg\")))\n\t    self.depth_paths = sorted(list((self.dataset_path / \"results\").glob(\"depth*.png\")))"},"children":[]}]},{"data":{"id":"dfiyea81se80","created":1767849642860,"text":"load_poses批量加载pose"},"children":[{"data":{"id":"dfiyervl4fs0","created":1767849681288,"text":"self.load_poses(self.dataset_path / \"traj.txt\")"},"children":[]}]},{"data":{"id":"dfiyetttq400","created":1767849685535,"text":"num_loaded_frames"},"children":[{"data":{"id":"dfiyf3jb92o0","created":1767849706668,"text":"加载的帧数len(self)"},"children":[]}]},{"data":{"id":"dfiyfb9kbq00","created":1767849723492,"text":"打印加载了xx帧"},"children":[{"data":{"id":"dfiyfnectlc0","created":1767849749903,"text":"print(f\"Loaded {num_loaded_frames} frames\")"},"children":[]}]}]}]},{"data":{"id":"dfiygimv0s00","created":1767849817898,"text":"函数"},"children":[{"data":{"id":"dfiygknw9ts0","created":1767849822314,"text":"load_poses()"},"children":[{"data":{"id":"dfiygnkhmjc0","created":1767849828638,"text":"输入path: str"},"children":[]},{"data":{"id":"dfiygq1zzgw0","created":1767849834051,"text":"打开path传入的文件，批量计算c2w并加载到poses"},"children":[{"data":{"id":"dfiyhhvrpgg0","created":1767849894624,"text":"with open(path, \"r\") as f:\n\t        lines = f.readlines() # 打开path指定的文件，以只读的方式读取\n\t    for line in lines:\n\t        c2w = np.array(list(map(float, line.split()))).reshape(4, 4) # 这里读取traj.txt并reshape为(4, 4)的np矩阵, line.split()将一行字符串由按空格切分为浮点数字符串, map(float, ..)转float, list()转为python列表\n\t        self.poses.append(c2w.astype(np.float32)) # 将该矩阵保存至.poses, .astype(np.float32)转float32节省内存"},"children":[]}]}]},{"data":{"id":"dfiyipd3p740","created":1767849989274,"text":"__getitem__()"},"children":[{"data":{"id":"dfiyiviljog0","created":1767850002667,"text":"传入"},"children":[{"data":{"id":"dfiyj2sugww0","created":1767850018524,"text":"index: int"},"children":[]}]},{"data":{"id":"dfiyj4wwgd40","created":1767850023122,"text":"传出"},"children":[{"data":{"id":"dfiyj61r5e80","created":1767850025593,"text":" frame_ids[index]"},"children":[]},{"data":{"id":"dfj15db532o0","created":1767857407629,"text":"color_data"},"children":[]},{"data":{"id":"dfj15hvrr5k0","created":1767857417584,"text":"depth_data"},"children":[]},{"data":{"id":"dfj15j8um9s0","created":1767857420551,"text":"poses[index]"},"children":[]}]},{"data":{"id":"dfiykmljrrs0","created":1767850139984,"text":"torch.utils.data.Dataset特有结构，用于定义dataset[index]返回什么"},"children":[]}]}]}]},{"data":{"id":"dfivmcvx3q80","created":1767841812240,"text":"get_dataset()"},"children":[{"data":{"id":"dfj15qz163k0","created":1767857437372,"text":"输入"},"children":[{"data":{"id":"dfj15u2gfj40","created":1767857444109,"text":"dataset_name"},"children":[]}]},{"data":{"id":"dfj15wuzv200","created":1767857450189,"text":"输出"},"children":[{"data":{"id":"dfj15y8wb680","created":1767857453206,"text":"Replica或NotImplementedError"},"children":[]}]},{"data":{"id":"dfj16fudie80","created":1767857491510,"text":"通过name获取数据集类型"},"children":[]}]},{"data":{"id":"dfjz03y10qo0","created":1767952913161,"text":"看完此理论上可以自己引入数据集了。\nmagic-slam实际只使用了replica数据格式，我大概率得写自己的数据集提取类\n注意__getitem__方法实际调用方式为replica.dataset[index],返回一个包含frame_id,颜色数据,深度数据,gt位姿的元组"},"children":[]}]},{"data":{"id":"deyl7nkcge80","created":1765781249790,"text":"gaussian_model.py","font-weight":"bold"},"children":[{"data":{"id":"dfjyvkgfaug0","created":1767952557281,"text":"GaussianModel类"},"children":[{"data":{"id":"dfpocgwm5bs0","created":1768532209275,"text":"传入"},"children":[{"data":{"id":"dfpocpiuo9c0","created":1768532228034,"text":"球谐函数阶数sh_degree"},"children":[]},{"data":{"id":"dfpoczhkpr40","created":1768532249724,"text":"是否各项同性isotropic"},"children":[]}]},{"data":{"id":"dfjywyp4kds0","created":1767952666647,"text":"结构"},"children":[{"data":{"id":"dfjyx05fia80","created":1767952669809,"text":"__init__"},"children":[{"data":{"id":"dfjzc2k3j600","created":1767953850512,"text":"参数名列表，提示哪些字段构成模型状态gaussian_param_names","expandState":"collapse"},"children":[{"data":{"id":"dfpijbams880","created":1768515818952,"text":"active_sh_degree"},"children":[]},{"data":{"id":"dfpijdyxjwo0","created":1768515824774,"text":"xyz"},"children":[]},{"data":{"id":"dfpijevr11s0","created":1768515826759,"text":"features_dc"},"children":[]},{"data":{"id":"dfpijgk4ffk0","created":1768515830409,"text":"features_rest"},"children":[]},{"data":{"id":"dfpijirh25c0","created":1768515835207,"text":"scaling"},"children":[]},{"data":{"id":"dfpijjwbd680","created":1768515837677,"text":"rotation"},"children":[]},{"data":{"id":"dfpijkqddmo0","created":1768515839494,"text":"opacity"},"children":[]},{"data":{"id":"dfpijmjxi940","created":1768515843458,"text":"max_radii2D"},"children":[]},{"data":{"id":"dfpijp3c5ns0","created":1768515848985,"text":"xyz_gradient_accum"},"children":[]},{"data":{"id":"dfpijtu3its0","created":1768515859311,"text":"denom"},"children":[]},{"data":{"id":"dfpijumxgtc0","created":1768515861054,"text":"spatial_lr_scale"},"children":[]},{"data":{"id":"dfpijwtrhsg0","created":1768515865821,"text":"optimizer"},"children":[]}]},{"data":{"id":"dfpj4tbyp1c0","created":1768517503862,"text":"颜色相关","expandState":"expand"},"children":[{"data":{"id":"dfjzcf0usjc0","created":1767953877647,"text":"最大球谐次数max_sh_degree"},"children":[]},{"data":{"id":"dfjzgk7v3y80","created":1767954202411,"text":"实际启用的球谐次数active_sh_degree"},"children":[{"data":{"id":"dfpiz65bqeo0","created":1768517061573,"text":"刚开始只用低阶,后期用高阶"},"children":[]}]},{"data":{"id":"dfjzj2yjf940","created":1767954399935,"text":"颜色常量项(0阶球谐)_features_dc"},"children":[{"data":{"id":"dfpizt3u4480","created":1768517111549,"text":"形状为(P,1,3)，几何意义为所有方向上的颜色的平均值，RGB三通道"},"children":[]}]},{"data":{"id":"dfpil7p42y80","created":1768515967848,"text":"其他阶球谐_features_rest"},"children":[{"data":{"id":"dfpj27zo5b40","created":1768517300678,"text":"有空可以推导一下球谐函数"},"children":[]}]},{"data":{"id":"dfpirpb7dqw0","created":1768516476374,"text":"透明度_opacity"},"children":[]}]},{"data":{"id":"dfpj4upq4sw0","created":1768517506871,"text":"位置相关","expandState":"expand"},"children":[{"data":{"id":"dfjzitn64yo0","created":1767954379656,"text":"3D高斯的中心位置_xyz"},"children":[{"data":{"id":"dfpiz108zow0","created":1768517050383,"text":"形状为(P,3),P为高斯数量，每行一个(x,y,z)"},"children":[]}]},{"data":{"id":"dfpin0xvkpc0","created":1768516109869,"text":"轴向尺度_scaling","font-weight":"bold"},"children":[{"data":{"id":"dfpj3c1k6q00","created":1768517387863,"text":"形状为(P,3), 每个高斯一个(s_x,s_y,s_z), 存的是log(s), 定义协方差矩阵的一部分"},"children":[]},{"data":{"id":"dfpjcnlbi740","created":1768518118280,"text":"3DGS对协方差矩阵实际不存完整协方差矩阵，而是存对角尺度+旋转，Σ=Rdiag(sx2​,sy2​,sz2​)RT"},"children":[]},{"data":{"id":"dfpjktv98v40","created":1768518758855,"text":"拓展：数学角度，任何对称正定矩阵都可写成Σ=RΛRT, R为正交阵，Λ为对角矩阵"},"children":[]},{"data":{"id":"dfpjnwaoxmg0","created":1768518999234,"text":"从几何角度理解，先将空间旋转某个方向，在三个互相垂直的方向拉伸，然后转回去"},"children":[]}]},{"data":{"id":"dfpirgjicyo0","created":1768516457286,"text":"高斯的方向_rotation","font-weight":"bold"},"children":[{"data":{"id":"dfpj49r26w80","created":1768517461239,"text":"形状为(P,4), 四元数"},"children":[]}]},{"data":{"id":"dfpirtp1p280","created":1768516485919,"text":"最大投影半径max_radii2D","font-weight":"bold"},"children":[{"data":{"id":"dfpj5t955ko0","created":1768517582055,"text":"在所有视角下，投影到2D屏幕的最大半径"},"children":[]},{"data":{"id":"dfpje6sskn40","created":1768518238455,"text":"用于判断是否需要裁剪(半径太小)或拆分(半径太大)"},"children":[]}]}]},{"data":{"id":"dfpjbq260680","created":1768518045288,"text":"优化相关","expandState":"expand"},"children":[{"data":{"id":"dfpis0wt6480","created":1768516501625,"text":"位置梯度累积范数xyz_gradient_accum","font-weight":"bold"},"children":[{"data":{"id":"dfpk388ufn40","created":1768520200706,"text":"统计反向传播时位置梯度模长的和，用于判断是否这里的点不够用。(每次都被看见，每次都要求挪动，说明点不够)"},"children":[]},{"data":{"id":"dfpj6hhozw80","created":1768517634815,"text":"概念解释：反向传播：根据差值微调参数的过程；\n梯度模长：反应变化有多剧烈，这个点位置错的是否严重。"},"children":[]}]},{"data":{"id":"dfpis9fi1lc0","created":1768516520170,"text":"梯度统计的分母denom","font-weight":"bold"},"children":[{"data":{"id":"dfpjyn7wt3s0","created":1768519841481,"text":"有的点被看到次数多，有的点看到次数少，用于记录被有效训练了多少次"},"children":[]}]},{"data":{"id":"dfpisiwe2gw0","created":1768516540782,"text":"Adam优化器状态optimizer"},"children":[]},{"data":{"id":"dfpj7p0uz0o0","created":1768517729576,"text":"densification阈值参数percent_dense","font-weight":"bold"},"children":[{"data":{"id":"dfpj8h3tqpk0","created":1768517790705,"text":"用于控制一次densify允许多少新增高斯，当前高斯球是否够用？"},"children":[]},{"data":{"id":"dfpjzm6y4740","created":1768519917610,"text":"做三件事之一：clone复制，split分裂，shrink，缩小尺度更精细"},"children":[]}]},{"data":{"id":"dfpj7s1my4w0","created":1768517736153,"text":"空间相关参数的学习率放大系数spatial_lr_scale","font-weight":"bold"},"children":[{"data":{"id":"dfpj8zmzsu00","created":1768517831046,"text":"将对应lr放大xx倍, 影响xyz和scaling；用Adam时lr会变，所以不能静态调整，必须动态给个倍数"},"children":[]}]}]},{"data":{"id":"dfpj7v34pc00","created":1768517742774,"text":"绑定激活函数setup_functions()","font-weight":"bold"},"children":[{"data":{"id":"dfpk6qcdxg00","created":1768520475195,"text":"绑定对scale, opacity, rotation三个参数激活的函数，实际分别对应exp, sigmoid, normalize, 由各参数的物理意义选定"},"children":[]},{"data":{"id":"dfpk9qzs3fk0","created":1768520711702,"text":"scale必须大于0且大一倍就是×2，exp可化乘法的变化方法为加法。opacity趋0则不重要，趋1则饱和，故需对中间态调整。rotation四元数必须标准化让模长为1"},"children":[]}]},{"data":{"id":"dfpj7y4g0xs0","created":1768517749383,"text":"是否强制让sx=sy=sz(各向同性) isotropic"},"children":[]},{"data":{"id":"dfpj81rjeag0","created":1768517757310,"text":"关键帧到高斯索引的映射表kf_id_to_gaussian_id"},"children":[{"data":{"id":"dfpjjlhsb6w0","created":1768518662262,"text":"用于观察keyframe负责生成/观测了哪些gaussian"},"children":[]}]}]}]},{"data":{"id":"dfpoboa2v600","created":1768532146962,"text":"函数方法"},"children":[{"data":{"id":"dfpodx9jpmw0","created":1768532323250,"text":"restore_from_params"},"children":[{"data":{"id":"dfpoe3bpbc00","created":1768532336441,"text":"传入"},"children":[{"data":{"id":"dfpoe4wrqb40","created":1768532339891,"text":"params_dict"},"children":[]},{"data":{"id":"dfpoe6jcreo0","created":1768532343434,"text":"training_args"},"children":[]}]},{"data":{"id":"dfpoipky8tc0","created":1768532698346,"text":"用已训练好的一组参数恢复gaussian model，使其能继续训练。举个例子，程序突然断了，但参数保留了，就能restore_from_params"},"children":[]}]},{"data":{"id":"dfpojokdzwo0","created":1768532774499,"text":"build_covariance_from_scaling_rotation","expandState":"expand"},"children":[{"data":{"id":"dfpq99s1t0g0","created":1768537600889,"text":"协方差矩阵的压缩表示(只保留不重复的6自由度)symm"},"children":[]}]},{"data":{"id":"dfpojtggn1k0","created":1768532785146,"text":"setup_functions"},"children":[{"data":{"id":"dfpqcew1jbc0","created":1768537847107,"text":"将scaling, opacity, rotation绑定对应函数"},"children":[]}]},{"data":{"id":"dfpojw20ezc0","created":1768532790802,"text":"capture_dict"},"children":[{"data":{"id":"dfpqge32pe80","created":1768538158812,"text":"返回当前模型优化后的值的快照，dict"},"children":[]}]},{"data":{"id":"dfpokjr500g0","created":1768532842388,"text":"获取xx信息类函数","expandState":"expand"},"children":[{"data":{"id":"dfpojy4lt7s0","created":1768532795314,"text":"get_size","expandState":"collapse"},"children":[{"data":{"id":"dfpqhx8a1i80","created":1768538278849,"text":"返回gaussian点云数量"},"children":[]}]},{"data":{"id":"dfpojzm2zd40","created":1768532798546,"text":"get_scaling","expandState":"collapse"},"children":[{"data":{"id":"dfpqo1kq1eo0","created":1768538758494,"text":"返回轴向尺度，若isotropic则只采用第一项并复制三遍"},"children":[]}]},{"data":{"id":"dfpok1vg79c0","created":1768532803466,"text":"get_xyz","expandState":"collapse"},"children":[{"data":{"id":"dfpqptmui8w0","created":1768538897937,"text":"返回gaussian点云坐标"},"children":[]}]},{"data":{"id":"dfpok3d9srs0","created":1768532806721,"text":"get_features"},"children":[]},{"data":{"id":"dfpok52aw1k0","created":1768532810411,"text":"get_opacity"},"children":[]},{"data":{"id":"dfpok6lkzgo0","created":1768532813753,"text":"get_active_sh_degree"},"children":[]},{"data":{"id":"dfpokq88qko0","created":1768532856482,"text":"get_covariance"},"children":[]}]},{"data":{"id":"dfpoky1dpbk0","created":1768532873482,"text":"add_points"},"children":[]},{"data":{"id":"dfpol0b4zmo0","created":1768532878425,"text":"training_setup"},"children":[]},{"data":{"id":"dfpol2czzf40","created":1768532882891,"text":"training_setup_camera"},"children":[]},{"data":{"id":"dfpol4wupg80","created":1768532888445,"text":"construct_list_of_attributes"},"children":[]},{"data":{"id":"dfpolanpyv40","created":1768532900954,"text":"save_ply"},"children":[]},{"data":{"id":"dfpolcb9af40","created":1768532904554,"text":"load_ply"},"children":[]},{"data":{"id":"dfpolfmubjk0","created":1768532911785,"text":"replace_tensor_to_optimizer"},"children":[]},{"data":{"id":"dfpolj4u10g0","created":1768532919403,"text":"_prune_optimizer"},"children":[]},{"data":{"id":"dfpollraphs0","created":1768532925115,"text":"prune_points"},"children":[]},{"data":{"id":"dfpolnjuafk0","created":1768532929018,"text":"cat_tensors_to_optimizer"},"children":[]},{"d